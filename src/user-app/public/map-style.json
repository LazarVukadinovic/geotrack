{
  "version": 8,
  "name": "GeoTrack Base No POI",
  "glyphs": "https://tiles.openfreemap.org/fonts/{fontstack}/{range}.pbf",
  "sources": {
    "openmaptiles": {
      "type": "vector",
      "url": "https://tiles.openfreemap.org/planet",
      "attribution": "© OpenStreetMap contributors © OpenFreeMap"
    }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#f4f1ec"
      }
    },
    {
      "id": "landcover",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landcover",
      "paint": {
        "fill-color": [
          "match",
          ["get", "class"],
          ["wood", "forest"], "#d7ead1",
          ["grass", "grassland", "meadow"], "#dfeecf",
          ["sand"], "#f2e7c9",
          ["ice", "snow"], "#f5f8fa",
          "#ece9e2"
        ],
        "fill-opacity": 0.9
      }
    },
    {
      "id": "landuse-green",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landuse",
      "filter": [
        "match",
        ["get", "class"],
        ["park", "cemetery", "school", "hospital", "pitch", "grass", "wood", "forest", "recreation_ground", "garden"],
        true,
        false
      ],
      "paint": {
        "fill-color": [
          "match",
          ["get", "class"],
          ["park", "garden", "recreation_ground"], "#d9eccb",
          ["cemetery"], "#d6e3cf",
          ["school", "hospital"], "#eee7dc",
          "#e3ecd9"
        ],
        "fill-opacity": 0.75
      }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "water",
      "paint": {
        "fill-color": "#9fc5e8"
      }
    },
    {
      "id": "waterway",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "waterway",
      "paint": {
        "line-color": "#9fc5e8",
        "line-width": ["interpolate", ["linear"], ["zoom"], 6, 0.4, 12, 1.2, 16, 2.4]
      }
    },
    {
      "id": "boundary-country",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "boundary",
      "filter": ["<=", ["to-number", ["get", "admin_level"]], 4],
      "paint": {
        "line-color": "#b9a99d",
        "line-width": ["interpolate", ["linear"], ["zoom"], 3, 0.5, 8, 1, 12, 1.5],
        "line-dasharray": [4, 2]
      }
    },
    {
      "id": "building",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "building",
      "minzoom": 14,
      "paint": {
        "fill-color": "#dedbd5",
        "fill-outline-color": "#c9c5be",
        "fill-opacity": 0.85
      }
    },
    {
      "id": "road-minor-casing",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 11,
      "filter": [
        "match",
        ["get", "class"],
        ["minor", "service", "track", "path", "pedestrian"],
        true,
        false
      ],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#d0cbc4",
        "line-width": ["interpolate", ["linear"], ["zoom"], 11, 0.6, 14, 2.2, 17, 7]
      }
    },
    {
      "id": "road-minor",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 11,
      "filter": [
        "match",
        ["get", "class"],
        ["minor", "service", "track", "path", "pedestrian"],
        true,
        false
      ],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#ffffff",
        "line-width": ["interpolate", ["linear"], ["zoom"], 11, 0.35, 14, 1.5, 17, 5.2]
      }
    },
    {
      "id": "road-major-casing",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": [
        "match",
        ["get", "class"],
        ["primary", "secondary", "tertiary", "trunk", "motorway"],
        true,
        false
      ],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#d4a75e",
        "line-width": ["interpolate", ["linear"], ["zoom"], 5, 0.8, 10, 2.2, 14, 5.2, 17, 12]
      }
    },
    {
      "id": "road-major",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": [
        "match",
        ["get", "class"],
        ["primary", "secondary", "tertiary", "trunk", "motorway"],
        true,
        false
      ],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": [
          "match",
          ["get", "class"],
          ["motorway", "trunk"], "#f7c46b",
          "#f4d493"
        ],
        "line-width": ["interpolate", ["linear"], ["zoom"], 5, 0.5, 10, 1.5, 14, 3.8, 17, 9]
      }
    },
    {
      "id": "road-name",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "transportation_name",
      "minzoom": 13,
      "layout": {
        "symbol-placement": "line",
        "text-field": ["coalesce", ["get", "name:latin"], ["get", "name:en"], ["get", "name"]],
        "text-font": ["Noto Sans Regular"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 13, 10, 16, 12, 18, 14],
        "text-padding": 2,
        "text-rotation-alignment": "map"
      },
      "paint": {
        "text-color": "#8b7b6b",
        "text-halo-color": "#ffffff",
        "text-halo-width": 1.2
      }
    },
    {
      "id": "water-name",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "water_name",
      "minzoom": 5,
      "layout": {
        "symbol-placement": "line",
        "text-field": ["coalesce", ["get", "name:latin"], ["get", "name:en"], ["get", "name"]],
        "text-font": ["Noto Sans Italic"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 5, 11, 12, 14],
        "text-padding": 2
      },
      "paint": {
        "text-color": "#5c8eb5",
        "text-halo-color": "#dbeaf6",
        "text-halo-width": 1
      }
    },
    {
      "id": "place-label-small",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "minzoom": 9,
      "filter": [
        "match",
        ["get", "class"],
        ["village", "hamlet", "suburb", "neighbourhood", "quarter"],
        true,
        false
      ],
      "layout": {
        "text-field": ["coalesce", ["get", "name:latin"], ["get", "name:en"], ["get", "name"]],
        "text-font": ["Noto Sans Regular"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 9, 10, 14, 13],
        "text-padding": 4,
        "text-allow-overlap": false
      },
      "paint": {
        "text-color": "#6f665d",
        "text-halo-color": "#f4f1ec",
        "text-halo-width": 1.3
      }
    },
    {
      "id": "place-label-large",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "filter": [
        "match",
        ["get", "class"],
        ["city", "town", "state", "country"],
        true,
        false
      ],
      "layout": {
        "text-field": ["coalesce", ["get", "name:latin"], ["get", "name:en"], ["get", "name"]],
        "text-font": ["Noto Sans Bold"],
        "text-size": [
          "interpolate",
          ["linear"],
          ["zoom"],
          3, 11,
          7, 14,
          11, 18,
          14, 22
        ],
        "text-padding": 8,
        "text-allow-overlap": false
      },
      "paint": {
        "text-color": "#4d4944",
        "text-halo-color": "#f4f1ec",
        "text-halo-width": 1.6
      }
    }
  ]
}