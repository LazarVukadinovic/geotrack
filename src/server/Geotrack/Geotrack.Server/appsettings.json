{
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
    "Database": {
        "AutoMigrate": false
    },
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning",
            "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
        }
    },
    "Jwt": {
        "Key": "",
        "Issuer": "Geotrack",
        "Audience": "GeotrackUsers"
    },
    "Cors": {
        "AllowedOrigins": []
    },
    "Seed": {
        "EnableOperationalSeed": false,
        "EnableDemoContentSeed": false,
        "Enabled": false,
        "RunInProduction": false
    },
    "ForwardedHeaders": {
        "Enabled": false,
        "ForwardLimit": 1,
        "KnownProxies": [],
        "KnownNetworks": []
    },
    "Agent": {
        "MaxPromptLength": 4000,
        "MaxConversationTurns": 8,
        "MaxContextItems": 6,
        "RequestTimeoutSeconds": 20,
        "MaxToolResults": 10
    },
    "Gemini": {
        "ApiKeys": [],
        "Model": "gemini-3.5-flash",
        "BaseUrl": "https://generativelanguage.googleapis.com",
        "KeyCooldownSeconds": 300,
        "MaxAttemptsPerRequest": 0
    },
    "Mcp": {
        "Enabled": true,
        "PublicBaseUrl": "",
        "RequireAuthForPrivateTools": true,
        "MaxResults": 10
    },
    "BoundaryImport": {
        "Adm0GeoJsonPath": "Data/Boundaries/geoBoundariesCGAZ_ADM0.geojson",
        "Adm1GeoJsonPath": "Data/Boundaries/geoBoundariesCGAZ_ADM1.geojson",
        "Adm2GeoJsonPath": "Data/Boundaries/geoBoundariesCGAZ_ADM2.geojson",
        "MaxSummaryItems": 100,
        "SaveBatchSize": 10,
        "ProgressLogInterval": 100
    },
    "RegionBoundaryBackfill": {
        "Aliases": {
            "HRV": {
                "Dalmatia": "Dubrovnik-Neretva",
                "Dubrovnik": "Dubrovnik-Neretva"
            }
        }
    },
    "RegionalScopeValidation": {
        "BoundaryToleranceMeters": 5000
    },
    "AllowedHosts": "*",
    "HttpsRedirection": {
        "Enabled": false
    },
    "Hsts": {
        "Enabled": false
    }
}
