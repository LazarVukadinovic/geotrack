{
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
    "Database": {
        "AutoMigrate": false
    },
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning",
            "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
        }
    },
    "Jwt": {
        "Key": "",
        "Issuer": "Geotrack",
        "Audience": "GeotrackUsers"
    },
    "Cors": {
        "AllowedOrigins": []
    },
    "UploadLimits": {
        "GlobalMaxRequestBodyBytes": 100663296,
        "GlobalMultipartBodyLengthLimitBytes": 10485760,
        "Images": {
            "MaxFileSizeBytes": 8388608,
            "MaxContributionFilesPerRequest": 10,
            "MaxRegionalFilesPerRequest": 12,
            "MaxContributionRequestBytes": 94371840,
            "MaxRegionalRequestBytes": 100663296,
            "ContributionAllowedContentTypes": [
                "image/png",
                "image/jpeg",
                "image/jpg",
                "image/gif",
                "image/webp"
            ],
            "ContributionAllowedExtensions": [
                ".png",
                ".jpg",
                ".jpeg",
                ".gif",
                ".webp"
            ],
            "RegionalAllowedContentTypes": [
                "image/png",
                "image/jpeg",
                "image/jpg",
                "image/webp"
            ],
            "RegionalAllowedExtensions": [
                ".png",
                ".jpg",
                ".jpeg",
                ".webp"
            ]
        },
        "ProofDocuments": {
            "MaxFileSizeBytes": 10485760,
            "MaxFilesPerRequest": 1,
            "AllowedContentTypes": [
                "application/pdf",
                "image/png",
                "image/jpeg",
                "image/jpg",
                "image/webp"
            ],
            "AllowedExtensions": [
                ".pdf",
                ".png",
                ".jpg",
                ".jpeg",
                ".webp"
            ]
        },
        "UserAvatars": {
            "MaxFileSizeBytes": 5242880,
            "AllowedContentTypes": [
                "image/png",
                "image/jpeg",
                "image/jpg",
                "image/webp"
            ],
            "AllowedExtensions": [
                ".png",
                ".jpg",
                ".jpeg",
                ".webp"
            ]
        },
        "AdminAvatars": {
            "MaxFileSizeBytes": 2097152,
            "AllowedContentTypes": [
                "image/png",
                "image/jpeg",
                "image/jpg",
                "image/webp"
            ],
            "AllowedExtensions": [
                ".png",
                ".jpg",
                ".jpeg",
                ".webp"
            ]
        }
    },
    "Seed": {
        "EnableOperationalSeed": false,
        "EnableDemoContentSeed": false,
        "Enabled": false,
        "RunInProduction": false
    },
    "ForwardedHeaders": {
        "Enabled": false,
        "ForwardLimit": 1,
        "KnownProxies": [],
        "KnownNetworks": []
    },
    "Agent": {
        "MaxPromptLength": 4000,
        "MaxConversationTurns": 8,
        "MaxContextItems": 6,
        "RequestTimeoutSeconds": 20,
        "MaxToolResults": 10,
        "NearbySearch": {
            "InitialRadiusKm": 10,
            "ExpansionRadiiKm": [ 25, 50, 100 ],
            "MaxRadiusKm": 100,
            "MaxResults": 10
        }
    },
    "Gemini": {
        "ApiKeys": [],
        "Model": "gemini-3.1-flash-lite",
        "FallbackModels": [ "gemini-3.5-flash" ],
        "BaseUrl": "https://generativelanguage.googleapis.com",
        "KeyCooldownSeconds": 300,
        "MaxAttemptsPerRequest": 0
    },
    "Mcp": {
        "Enabled": false,
        "PublicBaseUrl": "",
        "RequireAuth": true,
        "AllowAnonymousPublicTools": false,
        "RequireAuthForPrivateTools": true,
        "MaxResults": 10
    },
    "Notifications": {
        "EmailEnabled": false
    },
    "AnalyticsRetention": {
        "RetentionDays": 180,
        "BatchSize": 1000
    },
    "BoundaryImport": {
        "Adm0GeoJsonPath": "Data/Boundaries/geoBoundariesCGAZ_ADM0.geojson",
        "Adm1GeoJsonPath": "Data/Boundaries/geoBoundariesCGAZ_ADM1.geojson",
        "Adm2GeoJsonPath": "Data/Boundaries/geoBoundariesCGAZ_ADM2.geojson",
        "MaxSummaryItems": 100,
        "SaveBatchSize": 10,
        "ProgressLogInterval": 100
    },
    "RegionBoundaryBackfill": {
        "Aliases": {
            "HRV": {
                "Dalmatia": "Dubrovnik-Neretva",
                "Dubrovnik": "Dubrovnik-Neretva"
            }
        }
    },
    "RegionalScopeValidation": {
        "BoundaryToleranceMeters": 5000
    },
    "AllowedHosts": "*",
    "HttpsRedirection": {
        "Enabled": false
    },
    "Hsts": {
        "Enabled": false
    }
}
