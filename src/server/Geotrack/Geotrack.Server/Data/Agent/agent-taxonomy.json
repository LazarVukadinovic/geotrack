  "knowledgeDefinitions": [
    {
      "id": "skijanje",
      "aliases": [ "skijanje", "skiing", "ski" ],
      "answerSr": "Skijanje je zimski sport i rekreativna aktivnost u kojoj se osoba kreće po snegu pomoću skija. Može biti alpsko, nordijsko, rekreativno ili takmičarsko. Ako želiš, mogu da ti predložim GeoTrack destinacije za skijanje.",
      "answerEn": "Skiing is a winter sport and recreational activity where a person moves across snow using skis. It can be alpine, Nordic, recreational, or competitive. If you want, I can suggest GeoTrack destinations for skiing."
    },
    {
      "id": "plivanje",
      "aliases": [ "plivanje", "swimming", "swim" ],
      "answerSr": "Plivanje je fizička aktivnost i sport u kojem se osoba kreće kroz vodu koristeći pokrete tela, najčešće ruku i nogu. Može biti rekreativno, sportsko ili deo aktivnosti na moru, jezeru ili bazenu.",
      "answerEn": "Swimming is a physical activity and sport where a person moves through water using body movements, most often the arms and legs. It can be recreational, competitive, or part of a beach, lake, or pool activity."
    },
    {
      "id": "planinarenje",
      "aliases": [ "planinarenje", "hiking", "hike" ],
      "answerSr": "Planinarenje je rekreativna aktivnost kretanja po planinskim, šumskim ili prirodnim stazama. Može biti lagana šetnja, zahtevniji uspon ili višednevna tura, u zavisnosti od terena i pripreme.",
      "answerEn": "Hiking is a recreational activity that involves walking on mountain, forest, or nature trails. It can range from an easy walk to a demanding climb or multi-day route."
    },
    {
      "id": "muzej",
      "aliases": [ "muzej", "museum" ],
      "answerSr": "Muzej je ustanova koja čuva, istražuje i prikazuje predmete, umetnost, istoriju, prirodnu baštinu ili kulturu. Posetiocima pomaže da razumeju temu kroz izložbe i prateće programe.",
      "answerEn": "A museum is an institution that preserves, studies, and presents objects, art, history, natural heritage, or culture through exhibitions and related programs."
    },
    {
      "id": "plaza",
      "aliases": [ "plaža", "plaza", "beach" ],
      "answerSr": "Plaža je prostor uz more, jezero ili reku namenjen odmoru, sunčanju, šetnji i kupanju. Može biti peščana, šljunkovita, stenovita ili uređena kao javno kupalište.",
      "answerEn": "A beach is an area beside the sea, a lake, or a river used for relaxing, walking, sunbathing, and swimming. It may be sandy, pebbly, rocky, or managed as a public bathing area."
    },
    {
      "id": "restoran",
      "aliases": [ "restoran", "restaurant" ],
      "answerSr": "Restoran je ugostiteljski objekat u kojem se priprema i poslužuje hrana i piće. Može biti ležeran, porodični, lokalni, tematski ili namenjen finijem gastronomskom iskustvu.",
      "answerEn": "A restaurant is a hospitality venue where food and drinks are prepared and served. It can be casual, family-oriented, local, themed, or focused on a more refined dining experience."
    },
    {
      "id": "kafic",
      "aliases": [ "kafić", "kafic", "cafe", "coffee shop" ],
      "answerSr": "Kafić je ugostiteljski objekat u kojem se najčešće služe kafa, pića i lagani zalogaji. Često je mesto za kraći odmor, razgovor ili rad u opuštenoj atmosferi.",
      "answerEn": "A cafe is a hospitality venue that usually serves coffee, drinks, and light snacks. It is often used for a short break, conversation, or relaxed work."
    },
    {
      "id": "snorkeling",
      "aliases": [ "snorkeling", "snorkelling", "ronjenje s maskom", "ronjenje sa maskom" ],
      "answerSr": "Snorkeling je vodena aktivnost u kojoj se površinski pliva uz masku i disaljku kako bi se posmatrao podvodni svet. Najčešći je u mirnim, čistim priobalnim vodama.",
      "answerEn": "Snorkeling is a water activity where a person swims near the surface with a mask and snorkel to observe underwater life, usually in calm and clear coastal water."
    },
    {
      "id": "fine_dining",
      "aliases": [ "fine dining", "fino obedovanje", "visoka kuhinja" ],
      "answerSr": "Fine dining je stil restoranskog iskustva sa pažljivo osmišljenim jelovnikom, kvalitetnom uslugom, uređenim ambijentom i naglaskom na prezentaciju hrane i pića.",
      "answerEn": "Fine dining is a restaurant style focused on a carefully designed menu, polished service, a refined setting, and thoughtful presentation of food and drinks."
    },
    {
      "id": "festival",
      "aliases": [ "festival", "festivals" ],
      "answerSr": "Festival je organizovan događaj ili niz događaja posvećen muzici, filmu, hrani, kulturi, umetnosti ili nekoj lokalnoj tradiciji. Obično okuplja publiku tokom određenog perioda.",
      "answerEn": "A festival is an organized event or series of events dedicated to music, film, food, culture, art, or local tradition, usually held over a defined period."
    },
    {
      "id": "znamenitost",
      "aliases": [ "znamenitost", "attraction", "landmark", "sight" ],
      "answerSr": "Znamenitost je mesto, građevina, prirodni prizor ili kulturni sadržaj koji je prepoznatljiv i vredan posete zbog istorije, lepote, značaja ili lokalnog identiteta.",
      "answerEn": "An attraction or landmark is a place, building, natural feature, or cultural site worth visiting because of its history, beauty, significance, or local identity."
    }
  ],
